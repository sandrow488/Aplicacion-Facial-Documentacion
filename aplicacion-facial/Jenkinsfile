pipeline {
    agent any

    stages {
        stage('Descargar código') {
            steps {
                checkout scm
            }
        }

        stage('Validar código') {
            steps {
                sh '''
                    echo "Archivos en el repositorio:"
                    ls -la
                    echo "Validación completada correctamente"
                '''
            }
        }

        stage('Desplegar') {
            steps {
                sh '''
                    echo "Desplegado correctamente en $(date)"
                    echo "Commit: $(git log -1 --pretty=%B)"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completado correctamente'
        }
        failure {
            echo 'Pipeline fallido'
        }
    }
}
